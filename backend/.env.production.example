# Copy to .env on the EC2 server, then: docker compose up -d --build

NODE_ENV=production
PORT=3000
DISABLE_PAID_FEATURES=false

# Postgres runs as a container next to the API (see docker-compose.yml).
# DB_HOST / DB_PORT / DB_SSL are set by docker-compose, so only credentials go here.
DB_USERNAME=postgres
DB_PASSWORD=change_me_to_a_long_random_password
DB_NAME=nri_friends
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Copy remaining vars from your local .env (JWT, Firebase, AWS, etc.)
